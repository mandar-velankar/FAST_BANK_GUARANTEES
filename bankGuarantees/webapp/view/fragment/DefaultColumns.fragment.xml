<core:FragmentDefinition 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core">
    <Column visible="{= ${bg>/selectedCountry} !== 'ES'}">
        <Text text="{i18n>TenderStatus}"/>
    </Column>
    <Column  visible="{= ${bg>/selectedCountry} !== 'ES'}">
        <Text text="{i18n>Reference}"/>
    </Column>
    <Column  visible="{= ${bg>/selectedCountry} !== 'ES'}">
        <Text text="{i18n>IssueDate}"/>
    </Column>
    <Column id="ClosingDate" visible="false">
        <Text text="{i18n>ClosingDate}" />
    </Column>
    <Column id="ExpiryDate"  visible="{= ${bg>/selectedCountry} !== 'ES'}">
        <Text text="{i18n>ExpiryDate}"/>
    </Column>
</core:FragmentDefinition >