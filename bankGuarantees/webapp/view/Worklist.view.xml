<mvc:View controllerName="com.bayer.tender.bankguarantees.controller.Worklist"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" height="100%">

	<f:DynamicPage id="dynamicPageId" stickySubheaderProvider="iconTabBar" class="sapUiNoContentPadding" toggleHeaderOnTitleClick="false">

		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Bank Guarantees Management"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<f:content>
			<IconTabBar id="idIconTabBarFiori2" expanded="{device>/isNoPhone}" expandable="false" class="sapUiResponsiveContentPadding" select=".onQuickFilter">
				<items>
					<IconTabFilter text="Active" key="Active" />
					<IconTabFilter text="Expired" key="Expired" />
					<IconTabFilter text="Closed" key="Closed" />
				</items>
				<content>
					<Table id="table" width="auto" items="{
						path: '/BankGuarantees',
						sorter: {
							path: 'ID',
							descending: false
						},
						parameters: {
							expand: 'Tender,PriceAgreement'
						}

							
						
					}" noDataText="{worklistView>/tableNoDataText}" busyIndicatorDelay="{worklistView>/tableBusyDelay}" contextualWidth="Auto" popinLayout="Block" growing="true" growingThreshold="15" growingScrollToLoad="false" updateFinished=".onUpdateFinished">

						<headerToolbar>
							<OverflowToolbar>
								<Title id="tableHeader" text="{worklistView>/worklistTableTitle}" level="H3"/>
								<ToolbarSpacer />
                                <Select id="idSlctCountry"  
										selectedKey="{bg>/selectedCountry}"
                                        items="{ path: '/UserCountry', sorter: { path: 'Country/CountryName' }, 
										filters: {
											filters: [
												{ path: 'Application', operator: 'EQ', value1: 'BGR' },
												{ path: 'Application', operator: 'EQ', value1: 'ALL' }
											],
											and: false
										},
										parameters: { expand: 'Country' },
                                                events: {
                                                    dataReceived: '.onUserCountriesReceived'
                                                }
                                                }"
                                        change=".setFilter"
                                        visible="{= ${appView>/layout} === 'OneColumn' }">
                                        <core:Item key="{CountryCode}" text="{Country/CountryName}"/>
                                </Select>
								<SearchField id="searchField" tooltip="{i18n>worklistSearchTooltip}" search=".setFilter">
									<layoutData>
										<OverflowToolbarLayoutData maxWidth="200px" priority="NeverOverflow"/>
									</layoutData>
								</SearchField>
								<Button id="filterButton" press=".onOpenViewSettings" icon="sap-icon://filter" type="Transparent"/>
							</OverflowToolbar>
						</headerToolbar>

						<columns>
							<Column>
								<Text text="{i18n>AssociatedTender}"/>
							</Column>
							<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.DefaultColumns" type="XML" />
							<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.ESColumns" type="XML" />
							<Column >
								<Text text="{i18n>Type}"/>
							</Column>
							<Column>
								<Text text="{i18n>Amount}"/>
							</Column>
							<Column>
								<Text text="{i18n>AwardedValue}"/>
							</Column>
							<Column>
								<Text text="{i18n>Comment}"/>
							</Column>
							<Column hAlign="Begin" id="idBtnAction" width="6em">
								<Text text=""/>
							</Column>
						</columns>

						<dependents>
							<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.DefaultItems" type="XML" />
							<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.ESItems" type="XML" />
						</dependents>
						<items>
							<ColumnListItem>
								<cells>
									<ObjectIdentifier title="{TenderID}"/>
									<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.DefaultItems" type="XML" />
									<core:Fragment fragmentName="com.bayer.tender.bankguarantees.view.fragment.ESItems" type="XML" />
									<Text text="{Type}"/>
									<Text text="{
										path: 'GuaranteedAmount',
										type: 'sap.ui.model.type.Float',
										formatOptions: {
											minIntegerDigits: 3,
											maxFractionDigits: 2
										}
									} {Currency}" />
										<Text text="{
										path: 'GuaranteedAmount',
										type: 'sap.ui.model.type.Float',
										formatOptions: {
											minIntegerDigits: 3,
											maxFractionDigits: 2
										}
									} {Currency}" />
									<TextArea value="{Comment}" showExceededText="false" maxLength="500" valueLiveUpdate="false" liveChange="handleLiveChange" enabled="false"/>
									<Button text="Cancel" press=".onCancelGuarantee" visible="{= ${Status} !== 'Cancelled'}"/>

								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>

			</IconTabBar>
		</f:content>
	</f:DynamicPage>
</mvc:View>